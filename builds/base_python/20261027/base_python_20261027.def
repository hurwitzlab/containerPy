# ------------------------------------------------------------
# GENERATED by containerPy/generate_def.sh. Do not hand-edit the generated
# copy; change the image's config.sh / packages.txt and regenerate.
#
# Reproducibility pins:
#   base image : ghcr.io/prefix-dev/pixi:0.83.0-noble (Ubuntu + pixi), pinned by digest
#   conda/PyPI : inputs/pixi.lock: every package's exact URL and sha256,
#                solved by build.sh from inputs/pixi.toml with
#                exclude-newer = 2026-10-26 (channels: conda-forge bioconda, strict)
#   GitHub     : commit SHAs (enforced by generate_def.sh)
#   apt        : nothing installed; base image packages logged to dpkg_packages.tsv
#
# %files paths are relative: build from the build directory (build.sh cds
# there), after build.sh has written inputs/pixi.lock.
#
# %post is deliberately NOT indented: heredoc terminators must start at
# column 0.
# ------------------------------------------------------------

%labels
    Maintainer sdweave2@ncsu.edu
    Name base_python
    VersionTag 20261027
    Python_Version 3.13
    Base_Image ghcr.io/prefix-dev/pixi:0.83.0-noble
    Base_Digest sha256:3dce86c6e87371c58035aa41b09f2b56ca8f011722320551e0c2bfc1c59da5fb
    Snapshot_Date 2026-10-26
    Channels conda-forge bioconda
    Generated 2026-10-27T16:15:31Z by sdweave2

%help
    base_python (20261027): conda/Python environment (Python 3.13)
    with a pinned package set.

    Usage:
        apptainer exec base_python_20261027.sif python my_script.py
        apptainer exec base_python_20261027.sif <tool> ...    # e.g. samtools
        apptainer run  base_python_20261027.sif               # interactive Python

    What's inside (requested packages, versions, sources):
        apptainer exec base_python_20261027.sif base_python --help
        apptainer exec base_python_20261027.sif base_python --all

    Provenance (exact versions and hashes of everything installed):
        apptainer exec base_python_20261027.sif ls /opt/provenance
        apptainer exec base_python_20261027.sif cat /opt/provenance/pixi.lock

    The environment is read-only. Host PYTHONPATH, ~/.local site-packages
    and PERL5LIB are deliberately ignored.

%files
    inputs/pixi.toml /opt/env/pixi.toml
    inputs/pixi.lock /opt/env/pixi.lock

%post -c /bin/bash
# The header MUST be '%post -c /bin/bash'. Apptainer ignores shebangs in
# %post, and the default /bin/sh (dash) rejects 'set -o pipefail'. Without
# set -e a failed step still produces a "successful" but broken image.
set -euo pipefail

# Hazel bind-mount points
mkdir -p /rs1 /share /home /usr/local/usrapps
mkdir -p /opt/provenance

# Apptainer bind-mounts the build host's /tmp and /var/tmp into %post.
# build.sh binds a per-job scratch dir over them, but this .def may also be
# built by hand without that bind, so keep all scratch files (downloads,
# pixi's package cache) inside the image rootfs too.
# NEVER `rm` anything under /tmp here: it may be the host's real /tmp.
export TMPDIR=/opt/build-tmp
export PIXI_CACHE_DIR="$TMPDIR/pixi-cache" RATTLER_CACHE_DIR="$TMPDIR/pixi-cache"
mkdir -p "$TMPDIR"

# --- Install exactly what pixi.lock lists ------------------------------------
# --locked: fail rather than re-solve if the lock doesn't match pixi.toml.
# pixi checks each download against the sha256 in the lock.
# --run-post-link-scripts: conda runs packages' post-link scripts and some
# bioconda packages need them (e.g. Bioconductor data packages download
# their data there); pixi skips them unless asked.
# `pixi exec -s git`: git (needed to build GitHub refs) on PATH for this
# command only; it is not left in the image.
cd /opt/env
pixi exec -s git -- pixi install --locked --run-post-link-scripts
ENV=/opt/env/.pixi/envs/default
[[ -x "$ENV/bin/python" ]] || { echo "ERROR: no python in $ENV" >&2; exit 1; }

# Activation for %environment, frozen now as plain `export` lines: pixi runs
# the packages' activate.d scripts (e.g. openjdk sets JAVA_HOME) and reports
# the resulting variables. Those scripts are written for bash (libarrow's
# fails under /bin/sh) and some try to write into the environment, so they
# must not run at container start. The env path is fixed, so the values
# can't go stale. PATH is prepended, not frozen; PIXI_* and PS1 are dropped.
pixi shell-hook --locked --json > "$TMPDIR/activation.json"
"$ENV/bin/python" -I - "$TMPDIR/activation.json" "$ENV" > /opt/env/activate.sh <<'EOF'
import json, os, shlex, sys
data = json.load(open(sys.argv[1]))
env = data.get("environment_variables", data)
print("# Written by containerPy's template.def from 'pixi shell-hook --json'.")
print(f'export PATH="{sys.argv[2]}/bin:$PATH"')
for k in sorted(env):
    v = env[k]
    if k == "PATH" or k == "PS1" or k.startswith("PIXI_") or os.environ.get(k) == v:
        continue
    print(f"export {k}={shlex.quote(v)}")
EOF
grep -q '^export CONDA_PREFIX=' /opt/env/activate.sh || { echo "ERROR: activation has no CONDA_PREFIX" >&2; exit 1; }
cat /opt/env/activate.sh

# --- Provenance ---------------------------------------------------------------
cat > /opt/provenance/requested_packages.txt <<'EOF'
conda numpy
conda pandas
conda scipy
conda matplotlib
conda seaborn
conda scikit-learn
conda statsmodels
conda polars
conda pyarrow
conda openpyxl
conda pyyaml
conda ipython
conda tqdm
conda requests
conda biopython
EOF
cp /opt/env/pixi.toml /opt/env/pixi.lock /opt/provenance/
pixi list --locked --json > /opt/provenance/pixi_list.json
# Explicit conda spec: recreate the conda part with plain conda/micromamba
# (PyPI packages are not in it; they are in pixi.lock).
pixi workspace export conda-explicit-spec --ignore-pypi-errors /opt/provenance/

cat > /opt/provenance/provenance.py <<'EOF'
# Writes the package tables from pixi_list.json. Run by %post; kept in the
# image so the exact logic is recorded.
import json, os, sys
from importlib import metadata
from pathlib import Path

prov = Path("/opt/provenance")
env = Path(sys.prefix)
pkgs = sorted(json.load(open(prov / "pixi_list.json")), key=lambda p: p["name"].lower())
requested = [l.split() for l in open(prov / "requested_packages.txt") if l.strip()]

def source(p):
    if p["kind"] == "conda":
        return p["source"].rstrip("/").rsplit("/", 1)[-1]    # conda-forge, bioconda
    url = p.get("url") or ""
    if url.startswith("git+"):
        # git+https://github.com/owner/repo(.git)?...#<sha> -> GitHub owner/repo@sha
        repo = url[4:].split("#")[0].split("?")[0].split("@")[0]
        repo = repo.replace("https://github.com/", "").removesuffix(".git")
        return f"GitHub {repo}@{url.rsplit('#', 1)[-1]}"
    return "PyPI"

with open(prov / "package_versions.tsv", "w") as f:
    f.write("Package\tVersion\tSource\tRequested\n")
    for p in pkgs:
        f.write(f"{p['name']}\t{p['version']}\t{source(p)}\t{'yes' if p['is_explicit'] else ''}\n")

with open(prov / "installed_packages.tsv", "w") as f:
    cols = ["name", "version", "build", "kind", "source", "url", "sha256", "md5", "license"]
    f.write("\t".join(cols) + "\n")
    for p in pkgs:
        f.write("\t".join("" if p.get(c) is None else str(p[c]) for c in cols) + "\n")

# Commands provided by the requested packages (python's own are left out).
progs = set()
bindir = env / "bin"
for kind, name in requested:
    if kind == "conda":
        for meta in (env / "conda-meta").glob("*.json"):
            m = json.load(open(meta))
            if m["name"] == name:
                progs.update(f[4:] for f in m.get("files", []) if f.startswith("bin/") and "/" not in f[4:])
    else:
        for f in metadata.distribution(name).files or []:
            path = Path(f.locate()).resolve()
            if path.parent == bindir.resolve():
                progs.add(path.name)
progs = sorted(p for p in progs if os.access(bindir / p, os.X_OK))
(prov / "programs.txt").write_text("".join(p + "\n" for p in progs))
EOF
"$ENV/bin/python" -I /opt/provenance/provenance.py

dpkg-query -W -f='${Package}\t${Version}\n' > /opt/provenance/dpkg_packages.tsv

. /etc/os-release
cat > /opt/provenance/build_info.txt <<EOF
name           base_python
version_tag    20261027
python_version $("$ENV/bin/python" -c 'import platform; print(platform.python_version())')
base_image     ghcr.io/prefix-dev/pixi:0.83.0-noble
base_digest    sha256:3dce86c6e87371c58035aa41b09f2b56ca8f011722320551e0c2bfc1c59da5fb
pixi_version   $(pixi --version | awk '{print $2}')
os             ${PRETTY_NAME}
snapshot_date  2026-10-26
channels       conda-forge bioconda
env_prefix     ${ENV}
maintainer     sdweave2@ncsu.edu
generated      2026-10-27T16:15:31Z by sdweave2
built          $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

# --- `base_python --help`: say what is in the image -------------------------------
if [[ -e /usr/local/bin/base_python || -e "$ENV/bin/base_python" ]]; then
    echo "ERROR: 'base_python' is already a command in the image; use another NAME" >&2
    exit 1
fi
cat > /usr/local/bin/base_python <<'EOF'
#!/bin/bash
# Describe this image: requested packages and versions, and where the full
# build records are. Written by containerPy's template.def; reads only
# /opt/provenance, so it shows exactly what this image was built with.
set -euo pipefail
P=/opt/provenance
CMD=$(basename "$0")
IMG="${APPTAINER_CONTAINER:-${SINGULARITY_CONTAINER:-<image>.sif}}"
info() { awk -v k="$1" '$1 == k {sub(/^[^ ]+ +/, ""); print; exit}' "$P/build_info.txt"; }

# Table of package_versions.tsv rows; $1 = "yes" for requested only, "" for all.
table() {
    awk -F'\t' -v want="$1" '
        NR > 1 && (want == "" || $4 == want) {
            n++; p[n] = $1; v[n] = $2; s[n] = $3
            if (length($1) > w1) w1 = length($1)
            if (length($2) > w2) w2 = length($2)
        }
        END {
            fmt = "  %-" w1 "s  %-" w2 "s  %s\n"
            printf fmt, "Package", "Version", "Source"
            for (i = 1; i <= n; i++) printf fmt, p[i], v[i], s[i]
        }' w1=7 w2=7 "$P/package_versions.tsv"
}
count() { awk -F'\t' -v want="$1" 'NR > 1 && (want == "" || $4 == want)' "$P/package_versions.tsv" | wc -l; }
commands() { if [[ -s "$P/programs.txt" ]]; then fmt -w 76 < <(tr '\n' ' ' < "$P/programs.txt") | sed 's/^/  /'; else echo "  (none besides python)"; fi; }

case "${1:---help}" in
-h|--help)
    cat <<END
$(info name) $(info version_tag)
  Python $(info python_version); conda ($(info channels)) and PyPI packages as of $(info snapshot_date)
  Base image: $(info base_image) ($(info base_digest))
  Built $(info built), maintainer $(info maintainer)

Requested packages ($(count yes) of $(count "") installed; the rest are dependencies):
$(table yes)

Commands from the requested packages:
$(commands)

Run:
  python my_script.py                           (with the module loaded)
  apptainer exec $IMG python my_script.py

More:
  $CMD --all        every package in the image, with version and source
  $CMD --system     system (apt) packages of the base image
  $CMD --lockfile   pixi.lock (exact URL and sha256 of every package)
  Build records: /opt/provenance inside the image
END
    ;;
--all)      table "" ;;
--system)   printf 'Package\tVersion\n'; cat "$P/dpkg_packages.tsv" ;;
--lockfile) cat "$P/pixi.lock" ;;
--version)  echo "$(info name) $(info version_tag) (Python $(info python_version), snapshot $(info snapshot_date))" ;;
*)          echo "usage: $CMD [--help | --all | --system | --lockfile | --version]" >&2; exit 1 ;;
esac
EOF
chmod 755 /usr/local/bin/base_python

# --- Clean up ---------------------------------------------------------------
# NEVER touch /tmp here (host /tmp, see top of %post).
rm -rf "$TMPDIR" /root/.cache /root/.pixi

%environment
    # The conda environment: PATH, CONDA_PREFIX, packages' activate.d scripts.
    . /opt/env/activate.sh
    # Keep host Python/Perl settings out. Apptainer passes the host
    # environment through, and `unset` here does NOT remove host values, but
    # `export` overrides them. CPython ignores empty PYTHON* variables.
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=
    export PYTHONHOME=
    export PYTHONUSERBASE=
    export PYTHONSTARTUP=
    export PERL5LIB=
    export PERLLIB=
    # Host modules' libraries would shadow the environment's own.
    # /.singularity.d/libs is where `apptainer --nv` puts GPU driver libs.
    export LD_LIBRARY_PATH=/.singularity.d/libs

%runscript
    exec python "$@"

%test
    set -e
    # Simulate a host Python/conda/Perl setup leaking in.
    export PYTHONPATH=/host/leak PYTHONHOME=/host/leak PYTHONUSERBASE=/host/leak
    export PERL5LIB=/host/leak LD_LIBRARY_PATH=/host/leak CONDA_PREFIX=/host/leak
    . /.singularity.d/env/90-environment.sh
    # Not `python -I`: this must hold for python as users run it.
    python -c '
import json, os, site, sys
from importlib import metadata
from pathlib import Path
env = "/opt/env/.pixi/envs/default"
assert os.environ["CONDA_PREFIX"] == env, os.environ["CONDA_PREFIX"]
assert os.environ["PERL5LIB"] == "" and "leak" not in os.environ["LD_LIBRARY_PATH"]
assert sys.prefix == env, sys.prefix
bad = [p for p in sys.path if p and not p.startswith(env)]
assert not bad, f"host paths on sys.path: {bad}"
assert not site.ENABLE_USER_SITE, "user site-packages (~/.local) enabled"
names = {json.load(open(m))["name"] for m in Path(env, "conda-meta").glob("*.json")}
req = [l.split() for l in open("/opt/provenance/requested_packages.txt") if l.strip()]
for kind, name in req:
    if kind == "conda":
        assert name in names, f"conda package {name} not installed"
    else:
        metadata.version(name)
print("OK:", len(req), "requested packages installed; sys.prefix", sys.prefix)
'
    # Every listed command is on PATH from the environment.
    while read -r prog; do
        case "$(command -v "$prog")" in
            "$CONDA_PREFIX"/bin/*) ;;
            *) echo "command $prog not found in $CONDA_PREFIX/bin" >&2; exit 1 ;;
        esac
    done < /opt/provenance/programs.txt
    # The info command runs and lists every requested package as requested.
    base_python --help > /dev/null
    base_python --all > /dev/null
    [ "$(awk -F'\t' '$4 == "yes"' /opt/provenance/package_versions.tsv | wc -l)" \
      -eq "$(($(grep -c . /opt/provenance/requested_packages.txt) + 1))" ]
    echo "OK: base_python --help"
